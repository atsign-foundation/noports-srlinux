# NoPorts sshnpd settings for this SR Linux device.
#
# Copy to /etc/opt/sshnpd/sshnpd.env and edit. Read by run-sshnpd.sh and
# onboard-sshnpd.sh.

# The device atSign (identity of this router).
DEVICE_ATSIGN="@mydevice"

# atSign(s) permitted to connect; comma-separated for multiple managers.
MANAGER_ATSIGN="@colin"

# Device name as it appears to clients: `sshnp ... -d <DEVICE_NAME>`.
# Use something operators recognise, e.g. the router hostname.
DEVICE_NAME="srl-router-1"

# atDirectory (root) server. Management-plane ACLs usually block the ports
# NoPorts uses by default (atDirectory on 64100, atServers on high ports).
# The "proxy:" form sends ALL atProtocol traffic to one reverse proxy on
# one port instead — typically the right choice on a router:
#ROOT_SERVER="proxy:proxy0001.atsign.org:443"
#ROOT_SERVER="root.atsign.org"

# Path to the atKeys file for DEVICE_ATSIGN. Created by onboard-sshnpd.sh
# (APKAM enrollment — preferred over copying an atKeys file to the router).
# Default: /etc/opt/sshnpd/keys/${DEVICE_ATSIGN}_key.atKeys
#KEY_FILE="/etc/opt/sshnpd/keys/@mydevice_key.atKeys"

# Extra sshnpd flags, e.g. verbose logging or npt port policy.
# Run `sshnpd --help` for the full list for your installed version.
#   -v                       verbose logging
#   -s                       manage authorized_keys for the session key
#   --permit-open host:port  ports npt clients may request (e.g. gNMI 57400)
#EXTRA_ARGS="-v -s --permit-open localhost:22,localhost:57400"
